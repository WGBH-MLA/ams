<%  array_of_ids = presenter.list_of_contribution_ids_to_display %>
<%  contributions = presenter.member_presenters(array_of_ids) %>
<% if contributions.any? %>
<div class="block">
  <a class="btn btn-default btn-block header collapsed" id="tab-<%= t('.credits') %>" role="button" data-toggle="collapse" href="#collapse-<%= t('.credits') %>" aria-expanded="false" aria-controls="collapse-<%= t('.credits') %>">
    <%= t('.credits') %>
  </a>
  <div class="collapse" id="collapse-<%= t('.credits') %>">
    <div class="well">
      <table class="table table-striped">
        <thead>
        <tr>
          <th><%= t('.contributor') %></th>
          <th><%= t('.role') %></th>
          <th><%= t('.contributor_role_annotation') %></th>
          <th><%= t('.affiliation') %></th>
          <th><%= t('.affiliation_annotation') %></th>
          <th><%= t('.portrayal') %></th>
          <th><%= t('.annotation') %></th>
          <th><%= t('.start_time') %></th>
          <th><%= t('.end_time') %></th>
          <th><%= t('.time_annotation') %></th>
        </tr>
        </thead>
        <tbody>
        <% contributions.each  do |contribution|  %>
        <tr>
          <td><%= contribution.solr_document.try(:contributor).try(:first) %></td>
          <td><%= contribution.solr_document.try(:contributor_role).try(:first) %></td>
          <td><%= contribution.solr_document.try(:contributor_role_annotation).try(:first) %></td>
          <td><%= contribution.solr_document.try(:affiliation).try(:first) %></td>
          <td><%= contribution.solr_document.try(:affiliation_annotation).try(:first) %></td>
          <td><%= contribution.solr_document.try(:portrayal).try(:first) %></td>
          <td><%= contribution.solr_document.try(:annotation).try(:first) %></td>
          <td><%= contribution.solr_document.try(:start_time).try(:first) %></td>
          <td><%= contribution.solr_document.try(:end_time).try(:first) %></td>
          <td><%= contribution.solr_document.try(:time_annotation).try(:first) %></td>
        </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% end %>
