
<form action="/pushes" method="post">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <textarea style="width:100%; height: 12vw;" id="asset_ids_queue" type="text" name="asset_ids_queue" placeholder="GUIDs (one per line)">
    <%= params[:asset_ids_queue] %>
  </textarea>
  <input id="push-submit" class="aapb-push-button" type="submit" value="Send To AAPB" name="">
</form>

<div id="valid-box">
</div>

<div id="loader">
  <img src="/pbcore-logo.gif">
</div>

<script type="text/javascript">

  $(document).on('turbolinks:load', function() {
    $('#loader').hide();

    var timeout = Date.now();
    var inputActive = false;
    var init = true;

    $('#asset_ids_queue').on('change textInput input', function() {
      $('#loader').show();
      timeout = Date.now();
      inputActive = true;
    });

    setInterval(function(){
      if(init || (inputActive && Date.now() - timeout > 400)){
        validate( $('#asset_ids_queue').val() );
        inputActive = false;
        init = false;
      }
    }, 400);

    var boxval = $('#asset_ids_queue').val();
    if( boxval && boxval.length > 0 ){
      // validate if page loaded with ids
      $('#asset_ids_queue').trigger('change textInput input');
    }
  });

  function validate(asset_ids_queue_val){
    $.post('/pushes/validate_ids', { asset_ids_queue: asset_ids_queue_val }, function(resp) {
      $('#loader').hide();
      $('#valid-box').empty();

      var message;
      if(resp.error) {
        message = resp.error;
        $('#valid-box').addClass("red").removeClass("green");
      } else {
        message = "All GUIDs are valid!";
        $('#valid-box').addClass("green").removeClass("red");
      }

      messages_array = message.split("\n\n")
      messages_array.forEach(msg => {
        $('#valid-box').append('<p>' + msg + '</p>')
      });
    });
  }
</script>
