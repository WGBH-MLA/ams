<span id="pagination">
    <span class="page">
        Page <input id="page" name="page" value="<%= @pagination[:page] %>"> of <%= @pagination[:total_pages] %>
    </span>
    <span class="page">
        <select id="per_page" name="per_page">
            <% [10, 50, 100, 200].each do |option| %>
                <option value="<%= option %>" <%= 'selected' if option == @pagination[:per_page] %>><%= option %></option>
            <% end %>            
        </select> per page
    </span>
</span>